# Optional server-only settings. No key is needed for summaries or the local helper.
# Vercel: set these in Project Settings -> Environment Variables, then redeploy.
# Local: export them in your shell or use: node --env-file=.env scripts/dev-server.js
# ONE_PIECE_API_KEY=your-api-key
# ONE_PIECE_AI_ACCESS_CODE=choose-a-private-access-code-at-least-16-characters
# ONE_PIECE_MODEL=gpt-4.1-mini
# PORT=8080
